generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

/// Rol del usuario. Controla qué puede hacer más allá de estar autenticado.
enum Rol {
  USUARIO
  ADMIN
}

/// Usuario que se registra y publica reseñas.
model Usuario {
  id            Int      @id @default(autoincrement())
  correo        String   @unique
  nombre        String

  /// Contraseña hasheada con bcrypt.
  password      String

  /// Todo registro público crea USUARIO. ADMIN solo se asigna manualmente.
  rol           Rol      @default(USUARIO)

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  reviews       Review[]
}

/// Película sobre la que se escriben las reseñas.
model Pelicula {
  id            Int      @id @default(autoincrement())
  nombre        String
  imagen        String
  descripcion   String?
  estreno       Int?
  creadaEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  reviews       Review[]
}

/// Reseña (review) de una película escrita por un usuario.
model Review {
  id            Int      @id @default(autoincrement())
  titulo        String
  contenido     String
  /// Calificación de 1 a 5. Se valida el rango en el DTO.
  calificacion  Int
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  peliculaId    Int
  pelicula      Pelicula @relation(fields: [peliculaId], references: [id], onDelete: Cascade)

  autorId       Int
  autor         Usuario  @relation(fields: [autorId], references: [id], onDelete: Cascade)

  /// Un usuario solo puede reseñar una vez cada película.
  @@unique([peliculaId, autorId])
  @@index([peliculaId])
  @@index([autorId])
}
